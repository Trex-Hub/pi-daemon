{
  "name": "pi-daemon",
  "version": "0.1.0",
  "description": "Discord-to-Pi-coding-agent bridge daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-daemon": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check *.ts src",
    "lint:fix": "biome check --fix *.ts src",
    "test": "vitest run"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
