{
  "name": "agent-daemon",
  "version": "0.5.1",
  "description": "Discord-to-Pi-coding-agent bridge daemon",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-daemon": "dist/src/cli.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src",
    "!dist/src/*.test.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trex-Hub/pi-daemon.git"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check *.ts src",
    "lint:fix": "biome check --fix *.ts src",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.2",
    "fast-check": "^4.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "discord.js": "^14.27.0"
  }
}
